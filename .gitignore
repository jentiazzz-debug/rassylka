# Секреты. В .env — токен бота и ключи MTProto. Ключ шифрования сессий
# страшнее: им расшифровываются строки сессий из базы, а строка сессии —
# это вход в чужой аккаунт без пароля и кода.
.env
session.key
*.session
*.session-journal

# Данные. В базе лежат номера людей и их зашифрованные сессии — этому в
# репозитории места нет ни при каких обстоятельствах.
data/
*.db
*.db-wal
*.db-shm

# Мусор
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.venv/
venv/
.idea/
.vscode/
