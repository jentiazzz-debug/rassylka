# В образ не должно попасть ничего из этого: .env и ключ сессий подаются
# переменными окружения хостинга, а база живёт на подключённом томе — в
# слое образа она была бы одноразовой и уезжала бы в реестр вместе с
# чужими номерами.
.env
session.key
*.session
data/
*.db
*.db-wal
*.db-shm

.git/
.gitignore
__pycache__/
*.py[cod]
.venv/
venv/
.idea/
.vscode/
