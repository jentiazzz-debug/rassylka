# ==============================================================================
#  rassylka — бот и мини-апп для рассылок со своего аккаунта.
#  Скопируйте этот файл в .env рядом с main.py и заполните значения.
#  Файл с секретами в git не кладут.
# ==============================================================================

# --- Обязательное -------------------------------------------------------------

# Токен бота от @BotFather.
BOT_TOKEN=

# Ваш Telegram ID — ему открывается /stats.
OWNER_ID=

# Ник поддержки без «собаки» — из него делается кнопка «Поддержка».
# Либо готовая ссылка в SUPPORT_URL (например, на чат поддержки).
SUPPORT_USERNAME=
SUPPORT_URL=


# --- Мини-апп -----------------------------------------------------------------

# Публичный адрес приложения. Только https: Telegram не откроет ни http,
# ни localhost — кнопка будет, а нажатие ничего не даст.
#
# На своей машине проще всего туннелем:
#     cloudflared tunnel --url http://localhost:8080
# он выдаст адрес вида https://что-то.trycloudflare.com — его сюда.
# Пусто — бот запустится, но кнопки «Открыть приложение» не будет.
WEBAPP_URL=

# Свой веб-сервер. PORT на хостингах обычно приходит сам.
HOST=0.0.0.0
PORT=8080

# Сколько секунд считать подпись initData свежей. Сутки — компромисс:
# приложение живёт свёрнутым долго, а вечная подпись — плохая идея.
INITDATA_TTL=86400


# --- Аккаунты для рассылки ----------------------------------------------------
# Ключи MTProto. Выдают бесплатно на https://my.telegram.org,
# раздел API development tools. Без них подключить аккаунт по номеру
# нельзя: Bot API так не умеет.

MTPROTO_API_ID=
MTPROTO_API_HASH=

# Сколько аккаунтов может подключить один человек.
MAX_ACCOUNTS=5

# Сколько раз в час один человек может просить код. Тормоз стоит у нас,
# потому что Telegram за частые попытки входа наказывает не бота, а сам
# номер — FloodWait на часы.
CODE_REQUESTS_PER_HOUR=5

# Сколько живёт незавершённый вход, секунды.
LOGIN_TTL=600

# Потолок размера архива с tdata, мегабайты. Обычная tdata — единицы
# мегабайт; запас нужен тем, у кого в ней несколько аккаунтов и кэш.
MAX_TDATA_MB=64

# Ключ шифрования строк сессий (Fernet, base64). Пусто — ключ создастся
# сам файлом data/session.key. Ключ и база в одном томе означают, что
# доступ к тому даёт и то и другое, поэтому на хостинге лучше вписать
# ключ сюда. Сгенерировать:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Потерять ключ = потерять все подключённые аккаунты: расшифровать
# сессии будет нечем, людям придётся входить по номеру заново.
SESSION_KEY=


# --- Подписка -----------------------------------------------------------------

# Бесплатный пробный период, дней. Считается от первого /start.
TRIAL_DAYS=5

# Подпись, которая дописывается в конец каждого сообщения рассылки на
# бесплатном тарифе. На платном — не дописывается.
FREE_FOOTER=Рассылка бесплатно — @вашбот


# --- Подписка и оплата --------------------------------------------------------

# Тарифы подписки: «дни:монеты» через запятую. Подписка покупается за
# монеты — они же приходят от приглашённых, и обе дороги сходятся в одну.
PLANS=1:30,7:100,30:200

# Внутренняя валюта: как называется, какие пачки продаём и сколько
# звёзд стоит одна монета. Оплата звёздами Telegram — внутри мини-аппа
# это единственный разрешённый способ взять деньги за цифровую услугу.
COIN_NAME=Slx
STARS_PER_COIN=1

# Пачки монет: «монеты» или «монеты:цена в звёздах» — вторая форма даёт
# скидку. Процент скидки считается сам, из разницы с обычной ценой.
COIN_PACKS=50,100,200:190,500:460

# Какую пачку пометить значком «популярно». 0 — не помечать.
COIN_PACK_POPULAR=100

# Границы для «своего количества». Нижняя — чтобы счёт на одну монету не
# съедала комиссия, верхняя — чтобы опечатка не выставила счёт на
# миллион звёзд. Скидок на своё количество нет.
COIN_MIN=10
COIN_MAX=10000

# Приглашения: сколько монет за пришедшего по ссылке и сколько
# процентов с его пополнений. Процент важнее бонуса: платить только за
# регистрацию значит платить за пачки пустых аккаунтов.
REF_COINS=10
REF_PERCENT=10


# --- Рассылка -----------------------------------------------------------------
# Тормоза движка. Значения по умолчанию подобраны так, чтобы аккаунт
# жил долго. Уменьшать их — не «ускорить рассылку», а приблизить
# блокировку номера: наказывают аккаунт человека, а не бота.

# Минимальный интервал между сообщениями, секунды.
MIN_INTERVAL=60

# Разрыв между любыми двумя сообщениями одного аккаунта, секунды.
# Отдельно от интервала: рассылок у аккаунта может быть несколько.
ACCOUNT_MIN_GAP=20

# Потолок сообщений в сутки на аккаунт.
DAILY_LIMIT=200

# Разброс паузы, доля. 0.2 — гуляет ±20%. Ровный ритм секунда в секунду
# самый заметный признак робота.
INTERVAL_JITTER=0.2

# Сколько вариантов сообщения можно завести в одной рассылке.
MAX_VARIANTS=10

# Подписываться ли аккаунтом на чаты, где без подписки не пишут
# (обязательная подписка). Заодно вступаем в связанный канал — чаще
# всего требуют именно его.
AUTO_JOIN=true

# Потолок вступлений в сутки на аккаунт. Вступления Telegram считает
# отдельно от сообщений и наказывает за них так же, поэтому потолок
# заметно ниже, чем на сообщения.
JOIN_LIMIT=20

# Сколько не пробовать вступить в тот же чат после неудачи, секунды.
JOIN_RETRY_AFTER=86400

# Как часто движок смотрит очередь, секунды.
BROADCAST_TICK=5

# Сколько держать подключение аккаунта живым после отправки, секунды.
CLIENT_IDLE=600


# --- Реквизиты и документы ----------------------------------------------------
# ОБЯЗАТЕЛЬНО для согласования с банком и платёжной системой: они первым
# делом смотрят, с кем имеет дело клиент. Пока пусто — на страницах
# /terms и /privacy вместо реквизитов стоит заглушка, и такие документы
# не примут.

# Как вы указаны в документах: «ИП Иванов Иван Иванович»,
# «Самозанятый Иванов Иван Иванович» или «ООО «Ромашка»».
LEGAL_NAME=

# ИНН.
LEGAL_INN=

# Показывать ли ИП/ООО и ИНН в документах. По умолчанию нет: банк на
# согласовании просил убрать эти сведения из бота и документов. После
# регистрации кассы поставьте true — переписывать документы не нужно.
LEGAL_SHOW_REQUISITES=false

# Кодовое слово проверяющего на время согласования. Пока задано, видно
# на всех страницах документов и в боте. После регистрации кассы
# очистите переменную.
REVIEW_CODE=mellivora

# Почта поддержки. Банк не принимает группу как контакт — нужен адрес
# или тикет-система; ник в SUPPORT_USERNAME годится дополнительно.
LEGAL_EMAIL=

# Название сервиса в документах.
SERVICE_NAME=Solutions Рассылка

# Дата редакции документов. Пусто — сегодняшняя, но лучше зафиксировать:
# банк смотрит на дату.
LEGAL_DATE=


# --- Оплата рублями (Platega) -------------------------------------------------
# Ключи из личного кабинета Platega, раздел «Настройки». Пусто — оплата
# рублями выключена, остаётся оплата звёздами.

PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# В личном кабинете Platega, Настройки → Callback URLs, укажите:
#     https://ваш-домен/platega/callback

# Почём монета в рублях и пачки на продажу. Формат «монеты» или
# «монеты:цена». Комиссия эквайринга (у СБП НСПК это 8.5%) уже должна
# быть заложена в цену: сервис платит её из своей выручки.
RUB_PER_COIN=2
RUB_PACKS=50,100,200:380,500:920


# --- Оплата криптой (CryptoBot) -----------------------------------------------
# Токен приложения из @CryptoBot: Crypto Pay -> Create App. Пусто —
# оплата криптой выключена.

CRYPTO_PAY_TOKEN=

# Сколько монет даёт доллар и какие пачки продаём.
# Формат «доллары» или «доллары:монеты».
COINS_PER_USD=50
CRYPTO_PACKS=1,5,10,25


# --- Оплата криптой (xRocket) -------------------------------------------------
# Ключ приложения из @xRocket: xRocket Pay -> Create app. Пусто — оплата
# через xRocket выключена, остальные способы работают как работали.
# Второй кошелёк не заменяет CryptoBot, а стоит рядом: цена и пачки берутся
# из тех же COINS_PER_USD и CRYPTO_PACKS выше.

XROCKET_KEY=

# В чём выставлять счёт. Что xRocket принимает — отдаёт его же
# GET /currencies/available.
XROCKET_ASSET=USDT


# Нижние пороги для «своего количества». Готовые пачки идут по своим ценам,
# всё остальное считается по базовому курсу выше. Ниже этих сумм счёт не
# откроется уже на стороне провайдера, поэтому мини-апп их и показывает.

RUB_MIN=10
CRYPTO_MIN_USD=0.5


# --- Хранение -----------------------------------------------------------------

# Куда класть базу и ключ. На хостинге — примонтированный том, иначе всё
# сотрётся на первом же передеплое вместе с подключёнными аккаунтами.
DATA_DIR=
DB_PATH=
